# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/kavclass"

# Secret used to sign JWT auth tokens
JWT_SECRET="change-me"

# Secret required to call the admin password-reset endpoint
ADMIN_SECRET="change-me"

# Gmail account used to send password-reset emails (optional)
EMAIL_USER=""
EMAIL_PASS=""

# Stripe (subscriptions / checkout)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Asaas (cobrança automática Aluno→Escola via Pix/Boleto/Cartão, cada Escola
# traz a própria conta/API Key). ASAAS_ENCRYPTION_KEY é a chave MESTRA da
# plataforma usada só pra cifrar essas API Keys em repouso — 32 bytes em
# hex, gerar com `openssl rand -hex 32`. Rotas Asaas ficam desativadas (503)
# enquanto essa env var não existir.
ASAAS_ENCRYPTION_KEY=""
# Opcional: default https://api.asaas.com/v3. Usar
# https://sandbox.asaas.com/api/v3 pra testar sem mexer em dinheiro real.
ASAAS_API_BASE_URL=""

# Google Sign-In (OAuth 2.0 Client IDs do Google Cloud Console).
# Login com Google fica desativado (503) enquanto essas variáveis não existem.
GOOGLE_CLIENT_ID_WEB=""
GOOGLE_CLIENT_ID_IOS=""
GOOGLE_CLIENT_ID_ANDROID=""

# Fundação de identidade unificada (Rede Social Fase 1, Step 1). "false"
# (ou ausente) mantém /api/login e /api/auth/google/* no comportamento de
# sempre (direto em Professor/Aluno). Só virar "true" depois do backfill
# (scripts/backfill-conta.js) ter rodado em produção — ver plano da Fase 1.
USAR_CONTA_NO_LOGIN=""

# Multi-vínculo de verdade (Rede Social Fase 1, Step 2): permite criar uma
# 2ª linha Professor/Aluno pro mesmo e-mail (POST /api/professor/self/ativar,
# cadastro de aluno anexando a uma Conta existente). SÓ ligar depois de rodar
# as migrations 20260915130000/20260915130001 em produção — antes disso,
# o e-mail ainda é único globalmente no banco e criar uma 2ª linha falha.
MULTI_VINCULO_HABILITADO=""

PORT=3000
