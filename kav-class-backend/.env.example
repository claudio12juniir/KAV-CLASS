# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/kavclass"

# Secret used to sign JWT auth tokens
JWT_SECRET="change-me"

# Secret required to call the admin password-reset endpoint
ADMIN_SECRET="change-me"

# Gmail account used to send password-reset emails (optional)
EMAIL_USER=""
EMAIL_PASS=""

# Stripe (subscriptions / checkout)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Google Sign-In (OAuth 2.0 Client IDs do Google Cloud Console).
# Login com Google fica desativado (503) enquanto essas variáveis não existem.
GOOGLE_CLIENT_ID_WEB=""
GOOGLE_CLIENT_ID_IOS=""
GOOGLE_CLIENT_ID_ANDROID=""

PORT=3000
