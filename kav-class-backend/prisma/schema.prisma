generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────
// Extraídos dos valores literais realmente gravados pelo server.js e pelo
// app (my-app). Trocar String -> enum não muda o JSON devolvido pela API
// (enum ainda serializa como string), só passa a rejeitar valores inválidos
// no nível do banco em vez de aceitar qualquer typo silenciosamente.

enum StatusAluno {
  PENDENTE
  ATIVO
  INATIVO
}

enum StatusAssinaturaProfessor {
  PENDENTE
  ATIVO
  INATIVO
  VITALICIO
  CANCELADO
  TESTE
}

enum RecorrenciaAula {
  SEMANAL
  QUINZENAL
  MENSAL
}

enum StatusAula {
  AGENDADA
  CONCLUIDA
  CANCELADA
}

enum TipoAula {
  REGULAR
  REPOSICAO
  GRUPO
}

enum PresencaAula {
  PRESENTE
  AUSENCIA_PROFESSOR
  AUSENCIA_ALUNO
  PENDENTE_REPOSICAO
}

enum StatusPagamento {
  PENDENTE
  PAGO
  ATRASADO
  EM_ANALISE
  CANCELADO
}

enum MetodoPagamento {
  PIX
  CARTAO
  BOLETO
}

// Valores reais enviados pelo app (my-app/app/(professor)/index.tsx),
// diferentes dos documentados no comentário antigo do schema (PDF/VIDEO/AUDIO/TEXTO).
enum TipoMaterial {
  TEXTO
  LINK
  VIDEO
  IMAGEM
  ARQUIVO
  AUDIO
}

enum TipoNotificacao {
  CONTRATO_EXPIRADO
  CONTRATO_EXPIRANDO
  NOVO_ALUNO
  ALUNO_ATIVADO
}

enum StatusReposicao {
  AGUARDANDO
  CONFIRMADA
  SOLICITANDO_OUTRO
}

// Papel do Professor dentro da própria Escola. Todo Professor de hoje vira
// DONO da sua Escola de 1 pessoa na migração (ver 20260829000000_add_escola_multi_tenant) —
// GESTOR e o convite de mais professores para a mesma Escola só existem depois
// que a Escola assina o Pacote Escola (ver Escola.pacote). Sem isso, nada muda
// pra quem já usa o app hoje.
enum PapelUsuario {
  DONO
  GESTOR
  PROFESSOR
}

// Pacote comercial assinado pela Escola — decide qual conjunto de telas/rotas
// fica disponível. Não é derivado do nº de professores: é uma escolha do
// usuário na tela de assinatura (ver roadmap, Fase 0 / S0.2).
enum PacoteAssinatura {
  PACOTE_PROFESSOR
  PACOTE_ESCOLA
}

// ─── 0. ESCOLA ───────────────────────────────────────────────────
// Tenant raiz. Introduzida em S0.1 como infraestrutura aditiva: todo
// Professor/Aluno existente ganha uma Escola de 1 pessoa via backfill,
// sem nenhuma mudança de comportamento pra quem está no Pacote Professor.
// Os campos de assinatura (Stripe etc.) continuam em Professor nesta sprint
// — só migram pra cá numa sprint futura, junto da lógica de rota que os lê,
// pra não misturar duas mudanças de risco na mesma migration.
model Escola {
  id     String           @id @default(uuid())
  nome   String
  pacote PacoteAssinatura @default(PACOTE_PROFESSOR)

  professores Professor[]
  alunos      Aluno[]
  convites    ConviteProfessor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── 1. PROFESSOR ───────────────────────────────────────────────
model Professor {
  id                  String    @id @default(uuid())
  nome                String
  email               String    @unique
  senha               String
  telefone            String?
  dataNascimento      DateTime?
  codigoConvite       String?   @unique
  cursos              String[]
  expoPushToken       String?
  fotoUrl             String?
  chavePix            String?
  linkPagamentoCartao String?
  googleId            String?   @unique

  stripeCustomerId String?
  assinaturaStatus StatusAssinaturaProfessor @default(INATIVO)
  assinaturaFim    DateTime?
  stripeSessionId  String?

  escolaId String
  escola   Escola       @relation(fields: [escolaId], references: [id])
  papel    PapelUsuario @default(DONO)

  alunos       Aluno[]
  aulas        Aula[]
  pagamentos   Pagamento[]
  materiais    Material[]
  reposicoes   Reposicao[]
  notificacoes Notificacao[]
  mensagens    Mensagem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stripeCustomerId])
  @@index([escolaId])
}

// ─── 2. ALUNO ────────────────────────────────────────────────────
model Aluno {
  id             String    @id @default(uuid())
  nome           String
  email          String    @unique
  senha          String
  telefone       String?
  dataNascimento DateTime?
  curso          String?
  expoPushToken  String? // Token para push notifications
  fotoUrl        String?
  googleId       String?   @unique

  status             StatusAluno      @default(PENDENTE)
  valorMensalidade   Float?
  diaVencimento      Int?
  recorrenciaAula    RecorrenciaAula?
  diaSemanaAula      String? // Ex: "Segunda-feira"
  diaSemanaNumero    Int? // 0=Dom … 6=Sáb (para geração de aulas)
  horarioAula        String? // Ex: "14:30"
  tempoContrato      Int? // Em meses
  dataInicioContrato DateTime? // Data de ativação do contrato

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])

  // Cópia denormalizada do escolaId do professor no momento do cadastro.
  // Existe pra permitir consultas futuras escopadas por Escola (ex: GESTOR
  // vendo alunos de vários professores) sem precisar de join em toda rota.
  // A fonte de verdade continua sendo professor.escolaId.
  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  aulas      Aula[]
  pagamentos Pagamento[]
  reposicoes Reposicao[]
  mensagens  Mensagem[]
  materiais  Material[]

  @@index([professorId, status])
  @@index([status])
  @@index([escolaId])
}

// ─── 3. AULAS & AGENDA ───────────────────────────────────────────
model Aula {
  id       String        @id @default(uuid())
  tema     String?
  dataHora DateTime
  status   StatusAula    @default(AGENDADA)
  tipo     TipoAula      @default(REGULAR)
  presenca PresencaAula?

  // Evita reenviar o push de "aula amanhã" mais de uma vez pra mesma aula
  lembreteEnviado Boolean @default(false)

  professorId String
  professor   Professor  @relation(fields: [professorId], references: [id])
  alunoId     String
  aluno       Aluno      @relation(fields: [alunoId], references: [id])
  materiais   Material[]

  createdAt DateTime @default(now())

  @@index([professorId, dataHora])
  @@index([alunoId, dataHora])
  @@index([alunoId, status])
  @@index([professorId, presenca, dataHora])
}

// ─── 4. FINANCEIRO & PAGAMENTOS ──────────────────────────────────
model Pagamento {
  id             String           @id @default(uuid())
  valor          Float
  vencimento     DateTime
  dataPagamento  DateTime?
  status         StatusPagamento  @default(PENDENTE)
  comprovanteUrl String?
  metodo         MetodoPagamento?

  // Evita reenviar o push de "pagamento atrasado" todo dia pro mesmo boleto vencido
  notificadoAtrasado Boolean @default(false)

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])
  alunoId     String
  aluno       Aluno     @relation(fields: [alunoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professorId, status])
  @@index([professorId, vencimento])
  @@index([alunoId, vencimento])
}

// ─── 5. MATERIAIS DIDÁTICOS ──────────────────────────────────────
model Material {
  id       String       @id @default(uuid())
  titulo   String
  tipo     TipoMaterial
  url      String?
  conteudo String?

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])
  // Antes era uma String solta sem FK: um aluno excluído deixava materiais
  // órfãos e invisíveis. Agora é uma relação de verdade; ON DELETE SET NULL
  // porque a rota /api/aluno/materiais já trata alunoId nulo como "avulso".
  alunoId     String?
  aluno       Aluno?    @relation(fields: [alunoId], references: [id], onDelete: SetNull)
  aulaId      String?
  // Antes, sem onDelete, apagar uma Aula com material anexado quebrava com
  // erro de FK (NO ACTION). SET NULL casa com a mesma regra do alunoId acima.
  aula        Aula?     @relation(fields: [aulaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([professorId])
  @@index([alunoId])
  @@index([aulaId])
}

// ─── 6. MENSAGENS DO CHAT ────────────────────────────────────────
model Mensagem {
  id          String     @id @default(uuid())
  texto       String
  remetente   String // alunoId (UUID) | "professor"
  alunoId     String?
  // Já é SET NULL em produção (constraint existente) — mantido para não regredir.
  aluno       Aluno?     @relation(fields: [alunoId], references: [id], onDelete: SetNull)
  professorId String?
  professor   Professor? @relation(fields: [professorId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([alunoId, createdAt])
  @@index([professorId, remetente])
}

// ─── 7. NOTIFICAÇÕES ─────────────────────────────────────────────
model Notificacao {
  id         String          @id @default(uuid())
  tipo       TipoNotificacao
  titulo     String
  mensagem   String
  lida       Boolean         @default(false)
  dadosExtra String? // JSON serializado com dados adicionais (alunoId, etc.)

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])

  createdAt DateTime @default(now())

  @@index([professorId, lida])
  @@index([professorId, tipo])
}

// ─── 8. TOKEN DE REDEFINIÇÃO DE SENHA ───────────────────────────
model TokenRedefinicaoSenha {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usado     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, usado])
}

// ─── 9. REPOSIÇÕES ───────────────────────────────────────────────
model Reposicao {
  id           String          @id @default(uuid())
  professorId  String
  alunoId      String
  dataOriginal String?
  dataProposta String
  motivo       String
  status       StatusReposicao @default(AGUARDANDO)
  createdAt    DateTime        @default(now())

  professor Professor @relation(fields: [professorId], references: [id])
  aluno     Aluno     @relation(fields: [alunoId], references: [id])

  @@index([professorId])
  @@index([alunoId])
}

// ─── 10. CONVITE DE PROFESSOR PRA ESCOLA ─────────────────────────
// Só faz sentido pra Escola no Pacote Escola (ver Escola.pacote) — é como um
// DONO/GESTOR traz outro professor pra dentro do mesmo tenant, em vez de
// cada um ter sua própria Escola de 1 pessoa isolada.
model ConviteProfessor {
  id        String       @id @default(uuid())
  email     String
  token     String       @unique
  papel     PapelUsuario @default(PROFESSOR)
  expiresAt DateTime
  aceitoEm  DateTime?
  createdAt DateTime     @default(now())

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  @@index([escolaId, aceitoEm])
  @@index([email])
}
