generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────
// Extraídos dos valores literais realmente gravados pelo server.js e pelo
// app (my-app). Trocar String -> enum não muda o JSON devolvido pela API
// (enum ainda serializa como string), só passa a rejeitar valores inválidos
// no nível do banco em vez de aceitar qualquer typo silenciosamente.

enum StatusAluno {
  PENDENTE
  ATIVO
  INATIVO
}

enum StatusAssinaturaProfessor {
  PENDENTE
  ATIVO
  INATIVO
  VITALICIO
  CANCELADO
  TESTE
}

enum RecorrenciaAula {
  SEMANAL
  QUINZENAL
  MENSAL
}

enum StatusAula {
  AGENDADA
  CONCLUIDA
  CANCELADA
}

enum TipoAula {
  REGULAR
  REPOSICAO
  GRUPO
}

enum PresencaAula {
  PRESENTE
  AUSENCIA_PROFESSOR
  AUSENCIA_ALUNO
  PENDENTE_REPOSICAO
}

enum StatusPagamento {
  PENDENTE
  PAGO
  ATRASADO
  EM_ANALISE
  CANCELADO
}

enum MetodoPagamento {
  PIX
  CARTAO
  BOLETO
}

// Cobrança automática Aluno → Escola (S3.1 Stripe Connect, depois somado
// Asaas): qual dos dois gateways está ativo numa Matricula — mutuamente
// exclusivo, nunca os dois ao mesmo tempo.
enum GatewayCobranca {
  STRIPE
  ASAAS
}

// Valores reais enviados pelo app (my-app/app/(professor)/index.tsx),
// diferentes dos documentados no comentário antigo do schema (PDF/VIDEO/AUDIO/TEXTO).
enum TipoMaterial {
  TEXTO
  LINK
  VIDEO
  IMAGEM
  ARQUIVO
  AUDIO
}

enum TipoNotificacao {
  CONTRATO_EXPIRADO
  CONTRATO_EXPIRANDO
  NOVO_ALUNO
  ALUNO_ATIVADO
}

enum StatusReposicao {
  AGUARDANDO
  CONFIRMADA
  SOLICITANDO_OUTRO
  // A partir daqui: fluxo iniciado pelo aluno (S2.1), separado do fluxo
  // acima (professor propõe, aluno confirma). Emusys: "Solicitações de
  // reagendamento pedidas pelo aluno" — Pendente → Recusada ou Finalizada,
  // com aprovação do professor obrigatória antes da escola efetivar.
  SOLICITADA
  AUTORIZADA
  NEGADA
  FINALIZADA
}

// Quem começou o pedido de reposição — decide qual fluxo de status essa
// linha segue (ver StatusReposicao).
enum OrigemReposicao {
  PROFESSOR
  ALUNO
}

// CONTRATANTE: o próprio aluno é o responsável financeiro (maior de idade,
// paga por si). DEPENDENTE: outra pessoa (geralmente responsável legal de
// aluno menor de idade) é quem paga — ver Emusys, "Cadastro de pessoas".
enum VinculoResponsavel {
  CONTRATANTE
  DEPENDENTE
}

// Regra de remuneração do professor (INSTITUTION, Sprint 1 do briefing
// 08/09/2026) — v1 pragmática e global por Escola, sem regra por professor
// individual (isso é o escopo completo de S8.3/RegraPagamentoProfissional,
// que fica pra quando a Fase 7/RBAC estiver pronta, ver docs/institution-briefing-2026-09-08.md §6).
enum TipoRemuneracaoProfessor {
  POR_AULA
  POR_ALUNO_MES
}

// Estado de um slot na grade semanal recorrente do professor
// (DisponibilidadeProfessor). "Horário em aula" NÃO é um valor aqui — é
// derivado em tempo de leitura cruzando com Aula do dia/hora (ver runbook
// institution-sprint1).
enum TipoDisponibilidade {
  DISPONIVEL
  PAUSA
}

// Papel do Professor dentro da própria Escola. Todo Professor de hoje vira
// DONO da sua Escola de 1 pessoa na migração (ver 20260829000000_add_escola_multi_tenant) —
// GESTOR e o convite de mais professores para a mesma Escola só existem depois
// que a Escola assina o Pacote Escola (ver Escola.pacote). Sem isso, nada muda
// pra quem já usa o app hoje.
enum PapelUsuario {
  DONO
  GESTOR
  PROFESSOR
}

// Pacote comercial assinado pela Escola — decide qual conjunto de telas/rotas
// fica disponível. Não é derivado do nº de professores: é uma escolha do
// usuário na tela de assinatura (ver roadmap, Fase 0 / S0.2).
enum PacoteAssinatura {
  PACOTE_PROFESSOR
  PACOTE_ESCOLA
}

// ─── 0. ESCOLA ───────────────────────────────────────────────────
// Tenant raiz. Introduzida em S0.1 como infraestrutura aditiva: todo
// Professor/Aluno existente ganha uma Escola de 1 pessoa via backfill,
// sem nenhuma mudança de comportamento pra quem está no Pacote Professor.
// Os campos de assinatura (Stripe etc.) continuam em Professor nesta sprint
// — só migram pra cá numa sprint futura, junto da lógica de rota que os lê,
// pra não misturar duas mudanças de risco na mesma migration.
model Escola {
  id     String           @id @default(uuid())
  nome   String
  pacote PacoteAssinatura @default(PACOTE_PROFESSOR)

  // Código de autoingresso pra aluno (S6.1) — equivalente ao codigoConvite
  // do Professor, mas em nível de Escola: quem digita este código não
  // escolhe professor nenhum, cai PENDENTE numa fila de "sem professor
  // atribuído" até um DONO/GESTOR atribuir e aprovar. Gerado sob demanda
  // (mesmo padrão preguiçoso do codigoConvite de Professor em /api/dashboard).
  codigoConvite String? @unique

  // Regra de conversão experimental → matrícula (S4.3), configurável por
  // Escola. QUALQUER_MATRICULA (default): conta como conversão qualquer
  // matrícula do lead depois da experimental, sem checar curso/professor —
  // é o default mais permissivo, pra não esconder conversões reais numa
  // Escola que ainda não configurou nada. MESMO_CURSO_PROFESSOR: só conta
  // se a matrícula bater o mesmo professor (e o mesmo curso, quando a
  // experimental tinha um curso definido) da aula-teste.
  regraConversaoExperimental RegraConversaoExperimental @default(QUALQUER_MATRICULA)

  // Cobrança automática aluno→Escola (S3.1) — Stripe Connect Express. Cada
  // Escola recebe direto na própria conta conectada (não é a mesma conta
  // usada na assinatura Professor→Kav Class, que fica na Professor acima).
  // onboardingCompleto espelha charges_enabled+payouts_enabled do Stripe,
  // sincronizado pelo webhook account.updated e por checagem sob demanda.
  stripeConnectAccountId          String?
  stripeConnectOnboardingCompleto Boolean @default(false)

  // Cobrança automática aluno→Escola via Asaas (Pix/Boleto/Cartão), somada
  // ao Stripe Connect acima. Diferente do stripeConnectAccountId (só um ID
  // de conta), aqui a Escola traz a própria conta Asaas: guardamos a API Key
  // dela CIFRADA em repouso (AES-256-GCM, chave mestra em
  // ASAAS_ENCRYPTION_KEY), nunca em texto puro — é um segredo de verdade,
  // não um ID. asaasApiKeyUltimos4 é só pra exibir "•••• 8f3a" no painel sem
  // precisar decifrar. asaasWebhookToken é gerado na conexão e a Escola cola
  // no próprio painel Asaas dela (não temos como registrar webhook por conta
  // de terceiro via API) — é como o endpoint único /asaas/webhook descobre
  // de qual Escola veio o evento.
  asaasApiKeyCriptografada String?
  asaasApiKeyUltimos4      String?
  asaasWebhookToken        String? @unique

  // ─── Perfil da Instituição (INSTITUTION, Sprint 1 do briefing 08/09/2026) ───
  // Nullable de propósito: escola já existente continua funcionando sem
  // preencher nada disso até passar por Perfil da Instituição uma vez.
  // horarioFuncionamento guarda a grade de dias úteis/fim de semana em JSON
  // livre (mesmo shape reaproveitado pela UI de Cronograma, Sprint 10) em vez
  // de tabela normalizada — não há necessidade de consulta relacional sobre
  // isso, só leitura/escrita do bloco inteiro pela tela de perfil.
  horarioFuncionamento Json?
  logoUrl              String?
  email                String?

  // valorPorAula é a base do cálculo de pagamento de professor (Sprint 7,
  // "coração do sistema" nas palavras do usuário) — v1 global por Escola,
  // não por professor (ver TipoRemuneracaoProfessor acima).
  valorPorAula             Float?
  tipoRemuneracaoProfessor TipoRemuneracaoProfessor @default(POR_AULA)
  diaFechamento            Int?

  professores          Professor[]
  alunos               Aluno[]
  convites             ConviteProfessor[]
  responsaveis         ResponsavelFinanceiro[]
  cursos               Curso[]
  salas                Sala[]
  turmas               Turma[]
  modalidades          Modalidade[]
  planosPagamento      PlanoPagamento[]
  tabelasValores       TabelaValores[]
  matriculas           Matricula[]
  pacotesCredito       PacoteCredito[]
  reservasSala         ReservaSala[]
  contratos            Contrato[]
  lancamentosCaixa     LancamentoCaixa[]
  fechamentosCaixa     FechamentoCaixa[]
  contasPagar          ContaPagar[]
  folhasPagamento      FolhaPagamentoProfessor[]
  despesasFixas        DespesaFixa[]
  cronogramas          CronogramaConteudo[]
  relatoriosAluno      RelatorioAluno[]
  estagiosFunil        EstagioFunil[]
  leads                Lead[]
  tarefasLead          TarefaLead[]
  linksCaptacao        LinkCaptacao[]
  aulasExperimentais   AulaExperimental[]
  diasNaoLetivos       DiaNaoLetivo[]
  comunicados          Comunicado[]
  produtos             Produto[]
  movimentacoesEstoque MovimentacaoEstoque[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── 1. PROFESSOR ───────────────────────────────────────────────
model Professor {
  id                  String    @id @default(uuid())
  nome                String
  email               String    @unique
  senha               String
  telefone            String?
  dataNascimento      DateTime?
  codigoConvite       String?   @unique
  cursos              String[]
  expoPushToken       String?
  fotoUrl             String?
  chavePix            String?
  linkPagamentoCartao String?
  googleId            String?   @unique

  // ─── Cadastro completo de Equipe (INSTITUTION, Sprint 1 do briefing 08/09/2026) ───
  // Nullable de propósito: professor já cadastrado antes desta sprint
  // continua funcionando sem esses dados até a escola completar o cadastro
  // em equipe.tsx. dataPagamento é o dia do mês (1-31) em que a escola paga
  // o professor — não confundir com Escola.diaFechamento (data de corte do
  // cálculo, não da liberação do pagamento).
  contatoEmergencia String?
  dataPagamento     Int?
  contratoUrl       String?

  stripeCustomerId String?
  assinaturaStatus StatusAssinaturaProfessor @default(INATIVO)
  assinaturaFim    DateTime?
  stripeSessionId  String?

  escolaId String
  escola   Escola       @relation(fields: [escolaId], references: [id])
  papel    PapelUsuario @default(DONO)

  // Soft delete de "remover professor da Equipe" (auditoria INSTITUTION,
  // 11/09/2026): professorId é obrigatório (sem `?`) em 11 tabelas (Aula,
  // Matricula, Pagamento, Avaliacao, FolhaPagamentoProfessor etc) — apagar
  // a linha de verdade quebraria todo o histórico. Desligar só marca
  // ativoNaEscola=false: some da lista da Equipe, bloqueia login
  // (POST /api/login), mas Aula/Matricula/Pagamento/Avaliacao continuam
  // intactos.
  ativoNaEscola Boolean @default(true)

  alunos              Aluno[]
  aulas               Aula[]
  pagamentos          Pagamento[]
  materiais           Material[]
  reposicoes          Reposicao[]
  notificacoes        Notificacao[]
  mensagens           Mensagem[]
  turmas              Turma[]
  matriculas          Matricula[]
  avaliacoes          Avaliacao[]
  leadsDeInteresse    Lead[]
  tarefasLead         TarefaLead[]
  linksCaptacao       LinkCaptacao[]
  aulasExperimentais  AulaExperimental[]
  comunicadosEnviados Comunicado[]
  disponibilidades    DisponibilidadeProfessor[]
  mensagensTurma      MensagemTurma[]
  folhasPagamento     FolhaPagamentoProfessor[]
  cronogramas         CronogramaConteudo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stripeCustomerId])
  @@index([escolaId])
}

// ─── DISPONIBILIDADE DO PROFESSOR (INSTITUTION, Sprint 1 do briefing 08/09/2026) ───
// Grade semanal RECORRENTE (não são slots de uma semana específica): a
// escola marca em quais dias/horas o professor pode dar aula. É regra
// global — quando a escola tenta marcar aula de um aluno na grade desse
// professor, só os horários DISPONIVEL ficam clicáveis (aplicado na UI de
// Equipe/Logística, não faz sentido travar isso a nível de banco). PAUSA é
// café/almoço — bloqueado igual a um horário fora da disponibilidade.
// "Horário em aula" não tem valor de tipo aqui: é derivado cruzando
// diaSemana/horaInicio/horaFim com Aula.dataHora do professor no dia.
model DisponibilidadeProfessor {
  id         String              @id @default(uuid())
  diaSemana  Int // 0=Dom … 6=Sáb, mesmo padrão de Aluno.diaSemanaNumero
  horaInicio String // "HH:mm"
  horaFim    String // "HH:mm"
  tipo       TipoDisponibilidade @default(DISPONIVEL)

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professorId, diaSemana])
}

// ─── 2. ALUNO ────────────────────────────────────────────────────
model Aluno {
  id             String    @id @default(uuid())
  nome           String
  email          String    @unique
  senha          String
  telefone       String?
  dataNascimento DateTime?
  curso          String?
  expoPushToken  String? // Token para push notifications
  fotoUrl        String?
  googleId       String?   @unique

  // Anotação privada do professor sobre o aluno — nunca exposta pra rota
  // do próprio aluno, só pra quem já é dono dele (GET/PUT /api/alunos/:id/anotacoes).
  anotacoesPrivadas String?

  status             StatusAluno      @default(PENDENTE)
  valorMensalidade   Float?
  diaVencimento      Int?
  recorrenciaAula    RecorrenciaAula?
  diaSemanaAula      String? // Ex: "Segunda-feira"
  diaSemanaNumero    Int? // 0=Dom … 6=Sáb (para geração de aulas)
  horarioAula        String? // Ex: "14:30"
  tempoContrato      Int? // Em meses
  dataInicioContrato DateTime? // Data de ativação do contrato

  // Anexo do contrato fechado (INSTITUTION Sprint 5, briefing 08/09/2026) —
  // upload de arquivo, distinto de Contrato (fluxo de assinatura digital por
  // token, por Matricula). Nullable de propósito: aluno cadastrado antes
  // desta sprint, ou sem contrato em papel anexado, continua funcionando.
  contratoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Opcional de propósito (S6.1): aluno cadastrado com o código da Escola
  // (em vez do código de um Professor específico) entra sem professor
  // atribuído, PENDENTE numa fila da Escola até um DONO/GESTOR atribuir um
  // professor — só depois disso passa pelo fluxo normal de configuração.
  professorId String?
  professor   Professor? @relation(fields: [professorId], references: [id])

  // Cópia denormalizada do escolaId do professor no momento do cadastro.
  // Existe pra permitir consultas futuras escopadas por Escola (ex: GESTOR
  // vendo alunos de vários professores) sem precisar de join em toda rota.
  // A fonte de verdade continua sendo professor.escolaId.
  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  // Nullable de propósito: alunos já cadastrados antes de S1.1 continuam
  // funcionando sem responsável formal até alguém preencher via
  // PUT /api/alunos/:id/responsavel (ver docs/roadmap-escola.md, Fase 1).
  responsavelId      String?
  responsavel        ResponsavelFinanceiro? @relation(fields: [responsavelId], references: [id])
  vinculoResponsavel VinculoResponsavel?

  aulas                Aula[]
  pagamentos           Pagamento[]
  reposicoes           Reposicao[]
  mensagens            Mensagem[]
  materiais            Material[]
  matriculas           Matricula[]
  avaliacoes           Avaliacao[]
  comprasCredito       CompraCredito[]
  reservasSala         ReservaSala[]
  movimentacoesEstoque MovimentacaoEstoque[]
  relatorios           RelatorioAluno[]
  envioComunicados     EnvioComunicado[]

  @@index([professorId, status])
  @@index([status])
  @@index([escolaId])
  @@index([responsavelId])
}

// ─── 2b. RESPONSÁVEL FINANCEIRO ──────────────────────────────────
// Pessoa que paga pelo aluno — pode ser o próprio aluno (CONTRATANTE) ou
// outra pessoa, tipicamente responsável legal de um menor (DEPENDENTE).
// Escopado por Escola (não por Professor) porque o mesmo responsável pode
// pagar por mais de um aluno, inclusive de professores diferentes na mesma
// Escola — ex.: dois irmãos com professores de instrumento diferentes.
model ResponsavelFinanceiro {
  id        String   @id @default(uuid())
  nome      String
  cpf       String?
  email     String?
  telefone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  escolaId String
  escola   Escola  @relation(fields: [escolaId], references: [id])
  alunos   Aluno[]

  @@index([escolaId])
  @@index([escolaId, cpf])
}

// ─── 3. AULAS & AGENDA ───────────────────────────────────────────
model Aula {
  id       String        @id @default(uuid())
  tema     String?
  dataHora DateTime
  status   StatusAula    @default(AGENDADA)
  tipo     TipoAula      @default(REGULAR)
  presenca PresencaAula?

  // Evita reenviar o push de "aula amanhã" mais de uma vez pra mesma aula
  lembreteEnviado Boolean @default(false)

  professorId String
  professor   Professor  @relation(fields: [professorId], references: [id])
  alunoId     String
  aluno       Aluno      @relation(fields: [alunoId], references: [id])
  materiais   Material[]

  // Opcionais: uma aula avulsa (o modo de hoje) não precisa de Turma nem
  // Sala. Quando existem, servem pra agrupar/relatar por turma ou sala sem
  // mudar nada de como a aula em si é criada ou tem presença registrada.
  turmaId String?
  turma   Turma?  @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  salaId  String?
  sala    Sala?   @relation(fields: [salaId], references: [id], onDelete: SetNull)

  // Aula online (Fase 5, S5.5): link colado manualmente pelo professor (ex.:
  // meet.google.com/xxx-xxxx-xxx, criado fora do app) — não é geração
  // automática via Google Calendar API (exigiria OAuth adicional, decisão de
  // negócio em aberto). Presença deste campo é o que decide se o botão de
  // "Entrar na aula" aparece — sem precisar de um campo tipo/enum novo.
  linkOnline String?

  // ─── Presença dupla + decisão de reposição (INSTITUTION Sprint 2, briefing 08/09/2026) ───
  // Nullable de propósito: aula criada antes desta sprint (e toda aula fora
  // do fluxo de check-in biométrico) continua funcionando só com `presenca`
  // como sempre funcionou. presencaProfessorEm/presencaAlunoEm são
  // confirmações INDEPENDENTES (cada lado só grava o próprio timestamp);
  // `presenca` continua sendo atualizado pelas rotas novas quando os dois
  // batem, pra não quebrar relatório nenhum que já lê esse campo.
  presencaProfessorEm      DateTime?
  presencaAlunoEm          DateTime?
  // Auditoria de quando a escola faz override manual (só com a senha de
  // quem está sendo marcado — nunca a senha de quem está logado).
  confirmadoManualmentePor String? // "PROFESSOR" | "ALUNO"
  motivoManual             String?
  // Decisão da escola sobre "é reposição ou não" — campo À PARTE do fluxo
  // de solicitação/aprovação de Reposicao (model Reposicao/StatusReposicao,
  // já existente e com fluxo de 2 camadas próprio). Não confundir os dois:
  // aqui é só uma marcação editável na Grade de hoje, sem aprovação nenhuma.
  decisaoReposicao         Boolean?

  // Assunto dado na aula (INSTITUTION Sprint 9, briefing 08/09/2026) —
  // preenchido pelo professor ao confirmar presença, com base no
  // CronogramaConteudo vigente do curso (universal ou pessoal).
  assuntoTratado String?

  avaliacoes Avaliacao[]

  createdAt DateTime @default(now())

  @@index([professorId, dataHora])
  @@index([alunoId, dataHora])
  @@index([alunoId, status])
  @@index([professorId, presenca, dataHora])
  @@index([turmaId])
  @@index([salaId])
}

// ─── 4. FINANCEIRO & PAGAMENTOS ──────────────────────────────────
model Pagamento {
  id             String           @id @default(uuid())
  valor          Float
  vencimento     DateTime
  dataPagamento  DateTime?
  status         StatusPagamento  @default(PENDENTE)
  comprovanteUrl String?
  metodo         MetodoPagamento?

  // Evita reenviar o push de "pagamento atrasado" todo dia pro mesmo boleto vencido
  notificadoAtrasado Boolean @default(false)

  // Cobrança automática (S3.1): marca faturas geradas e cobradas sozinhas
  // pelo cron, distinguindo de fatura manual (professor gera, aluno paga
  // por fora). stripePaymentIntentId é o que o webhook usa pra encontrar
  // esta fatura quando o evento chega antes/depois da resposta síncrona
  // do PaymentIntent.
  viaCobrancaAutomatica Boolean @default(false)
  stripePaymentIntentId String?
  // Espelha o papel de stripePaymentIntentId acima, pro gateway Asaas — é o
  // que o webhook /asaas/webhook usa pra achar esta fatura (PAYMENT_CREATED
  // cria a linha, os eventos seguintes acham por este id).
  asaasPaymentId        String?

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])
  alunoId     String
  aluno       Aluno     @relation(fields: [alunoId], references: [id])

  // Nullable de propósito: os pagamentos gerados por /api/configurar-aluno
  // continuam existindo do jeito que sempre existiram, sem matrícula
  // vinculada. Só faturas geradas a partir de S2.2 (POST
  // /api/matriculas/:id/faturas) preenchem isso.
  matriculaId String?
  matricula   Matricula? @relation(fields: [matriculaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professorId, status])
  @@index([professorId, vencimento])
  @@index([alunoId, vencimento])
  @@index([matriculaId])
  @@index([stripePaymentIntentId])
  @@index([asaasPaymentId])
}

// ─── 5. MATERIAIS DIDÁTICOS ──────────────────────────────────────
model Material {
  id       String       @id @default(uuid())
  titulo   String
  tipo     TipoMaterial
  url      String?
  conteudo String?

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])
  // Antes era uma String solta sem FK: um aluno excluído deixava materiais
  // órfãos e invisíveis. Agora é uma relação de verdade; ON DELETE SET NULL
  // porque a rota /api/aluno/materiais já trata alunoId nulo como "avulso".
  alunoId     String?
  aluno       Aluno?    @relation(fields: [alunoId], references: [id], onDelete: SetNull)
  aulaId      String?
  // Antes, sem onDelete, apagar uma Aula com material anexado quebrava com
  // erro de FK (NO ACTION). SET NULL casa com a mesma regra do alunoId acima.
  aula        Aula?     @relation(fields: [aulaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([professorId])
  @@index([alunoId])
  @@index([aulaId])
}

// ─── 6. MENSAGENS DO CHAT ────────────────────────────────────────
model Mensagem {
  id          String     @id @default(uuid())
  texto       String
  remetente   String // alunoId (UUID) | "professor"
  alunoId     String?
  // Já é SET NULL em produção (constraint existente) — mantido para não regredir.
  aluno       Aluno?     @relation(fields: [alunoId], references: [id], onDelete: SetNull)
  professorId String?
  professor   Professor? @relation(fields: [professorId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([alunoId, createdAt])
  @@index([professorId, remetente])
}

// Quem escreveu uma mensagem no chat de turma (MensagemTurma) — professor
// ou um dos alunos ativos dele, nunca a Escola diretamente (a Escola só lê,
// não participa da conversa como terceira voz).
enum AutorMensagemTurma {
  PROFESSOR
  ALUNO
}

// ─── CHAT DA TURMA (INSTITUTION Sprint 4, briefing 08/09/2026) ───────────
// Grupo escopado por professorId (não por Turma — Aluno pode ter vários
// vínculos via Matricula, mas o chat da turma é do professor "dono" de
// login do aluno). Distinto de Mensagem (1:1 professor↔aluno) e de
// /api/mural (broadcast 1-via, sem resposta) — este é bidirecional e em
// grupo. Participantes (quem pode ler/postar) são calculados em tempo de
// consulta: alunos ATIVOS daquele professor sem mensalidade ATRASADO —
// sem tabela de membros dedicada, pra não duplicar o que já dá pra derivar
// de Aluno.status + Pagamento.status.
model MensagemTurma {
  id        String             @id @default(uuid())
  texto     String
  autorTipo AutorMensagemTurma
  autorId   String

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([professorId, createdAt])
}

// ─── 7. NOTIFICAÇÕES ─────────────────────────────────────────────
model Notificacao {
  id         String          @id @default(uuid())
  tipo       TipoNotificacao
  titulo     String
  mensagem   String
  lida       Boolean         @default(false)
  dadosExtra String? // JSON serializado com dados adicionais (alunoId, etc.)

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])

  createdAt DateTime @default(now())

  @@index([professorId, lida])
  @@index([professorId, tipo])
}

// ─── 8. TOKEN DE REDEFINIÇÃO DE SENHA ───────────────────────────
model TokenRedefinicaoSenha {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usado     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, usado])
}

// ─── 9. REPOSIÇÕES ───────────────────────────────────────────────
model Reposicao {
  id           String          @id @default(uuid())
  professorId  String
  alunoId      String
  dataOriginal String?
  dataProposta String
  motivo       String
  status       StatusReposicao @default(AGUARDANDO)
  // Default PROFESSOR preserva o significado de toda linha já existente —
  // até S2.1 só existia o fluxo iniciado pelo professor.
  origem       OrigemReposicao @default(PROFESSOR)
  createdAt    DateTime        @default(now())

  professor Professor @relation(fields: [professorId], references: [id])
  aluno     Aluno     @relation(fields: [alunoId], references: [id])

  @@index([professorId])
  @@index([alunoId])
}

// ─── 10. CONVITE DE PROFESSOR PRA ESCOLA ─────────────────────────
// Só faz sentido pra Escola no Pacote Escola (ver Escola.pacote) — é como um
// DONO/GESTOR traz outro professor pra dentro do mesmo tenant, em vez de
// cada um ter sua própria Escola de 1 pessoa isolada.
model ConviteProfessor {
  id        String       @id @default(uuid())
  email     String
  token     String       @unique
  papel     PapelUsuario @default(PROFESSOR)
  expiresAt DateTime
  aceitoEm  DateTime?
  createdAt DateTime     @default(now())

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  @@index([escolaId, aceitoEm])
  @@index([email])
}

// ─── 11. CURSO ────────────────────────────────────────────────────
// Simplificado na v1: curso é uma entidade nomeada plana, sem a árvore
// curso→módulo→disciplina→aula→tópico da Emusys. Convive por enquanto com
// Professor.cursos (lista livre de texto) e Aluno.curso (texto livre) —
// migrar esses campos pra apontar pra Curso é trabalho de UI de uma sprint
// futura, não desta.
model Curso {
  id    String  @id @default(uuid())
  nome  String
  ativo Boolean @default(true)

  escolaId String
  escola   Escola  @relation(fields: [escolaId], references: [id])
  turmas   Turma[]

  // Opcional: um curso pode apontar pra uma TabelaValores compartilhada
  // (S1.3). Sem tabela vinculada, o preço continua sendo o que já existe
  // hoje — digitado direto em Aluno.valorMensalidade por /api/configurar-aluno.
  tabelaValoresId String?
  tabelaValores   TabelaValores? @relation(fields: [tabelaValoresId], references: [id], onDelete: SetNull)

  aulasExperimentais AulaExperimental[]
  cronogramas        CronogramaConteudo[]
  diasNaoLetivos     DiaNaoLetivoCurso[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escolaId])
  @@index([tabelaValoresId])
}

// ─── COORDENAÇÃO (INSTITUTION Sprint 9, briefing 08/09/2026) ─────────────
// Duas opções de cronograma por curso: UNIVERSAL (a escola decide, sobe
// material — professorId fica null) ou PESSOAL (cada professor sobe o
// próprio, professorId obrigatório). Um curso pode ter várias entradas ao
// longo do tempo; "vigente" é sempre a mais recente por (cursoId,
// professorId) — não existe campo de "ativo" separado, pra não duplicar
// controle de estado com a ordenação por data.
enum TipoCronograma {
  UNIVERSAL
  PESSOAL
}

model CronogramaConteudo {
  id       String         @id @default(uuid())
  tipo     TipoCronograma
  anexoUrl String?
  titulo   String?

  cursoId String
  curso   Curso  @relation(fields: [cursoId], references: [id])

  // Nullable de propósito: só preenchido quando tipo=PESSOAL. UNIVERSAL é
  // decidido pela escola, sem dono individual.
  professorId String?
  professor   Professor? @relation(fields: [professorId], references: [id])

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cursoId, tipo])
  @@index([professorId])
}

// Relatório do aluno — solicitado pela coordenação a um professor, ou
// enviado direto pela própria coordenação (autorTipo distingue os dois,
// sem tabela separada pra cada caso).
enum AutorRelatorioAluno {
  PROFESSOR
  COORDENACAO
}

model RelatorioAluno {
  id        String              @id @default(uuid())
  autorTipo AutorRelatorioAluno
  descricao String?
  anexoUrl  String?

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id])

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  createdAt DateTime @default(now())

  @@index([alunoId, createdAt])
}

// ─── 12. SALA ─────────────────────────────────────────────────────
model Sala {
  id        String  @id @default(uuid())
  nome      String
  descricao String?
  ativa     Boolean @default(true)

  escolaId String
  escola   Escola        @relation(fields: [escolaId], references: [id])
  turmas   Turma[]
  aulas    Aula[]
  reservas ReservaSala[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escolaId])
}

// ─── 13. TURMA ────────────────────────────────────────────────────
// v1 assume 1 professor por turma (o mesmo modelo que Aula já usa hoje).
// "Múltiplos professores por turma" é uma config opcional da Emusys — fica
// pra uma sprint futura via tabela de vínculo dedicada, pra não misturar
// essa complexidade extra na primeira versão de Turma.
model Turma {
  id           String  @id @default(uuid())
  nome         String
  limiteAlunos Int?
  ativa        Boolean @default(true)

  cursoId String
  curso   Curso  @relation(fields: [cursoId], references: [id])

  salaId String?
  sala   Sala?   @relation(fields: [salaId], references: [id])

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  aulas      Aula[]
  matriculas Matricula[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escolaId])
  @@index([professorId])
  @@index([cursoId])
  @@index([salaId])
}

// Plano de pagamento: mensal, semestral, anual, livre — cada um pode ter um
// preço diferente pra mesma tabela de valores.
enum PeriodicidadePlano {
  MENSAL
  SEMESTRAL
  ANUAL
  LIVRE
}

// ─── 14. MODALIDADE ───────────────────────────────────────────────
// Frequência + duração da aula (ex.: "Semanal 60min"). Reaproveita o enum
// RecorrenciaAula que já existe pra Aluno, em vez de duplicar SEMANAL/
// QUINZENAL/MENSAL num enum novo.
model Modalidade {
  id             String          @id @default(uuid())
  nome           String
  frequencia     RecorrenciaAula
  duracaoMinutos Int
  padrao         Boolean         @default(false)

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escolaId])
}

// ─── 15. PLANO DE PAGAMENTO ───────────────────────────────────────
model PlanoPagamento {
  id            String             @id @default(uuid())
  nome          String
  periodicidade PeriodicidadePlano

  escolaId   String
  escola     Escola       @relation(fields: [escolaId], references: [id])
  valores    ValorPlano[]
  matriculas Matricula[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escolaId])
}

// ─── 16. TABELA DE VALORES ────────────────────────────────────────
// Uma tabela pode ser reaproveitada por vários Curso (ver Curso.tabelaValoresId)
// — editar/versionar a tabela propaga o preço pra todos eles.
model TabelaValores {
  id   String @id @default(uuid())
  nome String

  escolaId String
  escola   Escola                @relation(fields: [escolaId], references: [id])
  cursos   Curso[]
  versoes  VersaoTabelaValores[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escolaId])
}

// ─── 17. VERSÃO DA TABELA DE VALORES ──────────────────────────────
// O motor do reajuste anual: uma nova versão pode ser criada com
// antecedência (ativa=false) e só passa a valer quando ativada. Matrícula
// já existente nunca lê a versão ativa em tempo real — o valor já foi
// gravado em Aluno.valorMensalidade no momento da matrícula/renovação, então
// trocar a versão ativa aqui não altera nada de quem já está pagando. "Só
// uma versão ativa por tabela" é garantido na rota de ativação (desativa as
// irmãs na mesma transação), não por constraint de banco — evita a
// complexidade de um índice único parcial só pra isso.
model VersaoTabelaValores {
  id    String  @id @default(uuid())
  ativa Boolean @default(false)

  tabelaId String
  tabela   TabelaValores @relation(fields: [tabelaId], references: [id])
  valores  ValorPlano[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tabelaId, ativa])
}

// ─── 18. VALOR POR PLANO / FORMA DE PAGAMENTO ─────────────────────
// metodo = null é o valor "qualquer forma de pagamento" (fallback); uma
// linha com metodo preenchido (PIX/CARTAO/BOLETO) sobrepõe esse fallback só
// pra aquela forma específica — mesma regra da Emusys.
model ValorPlano {
  id     String           @id @default(uuid())
  metodo MetodoPagamento?
  valor  Float

  versaoId String
  versao   VersaoTabelaValores @relation(fields: [versaoId], references: [id])

  planoPagamentoId String
  planoPagamento   PlanoPagamento @relation(fields: [planoPagamentoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([versaoId, planoPagamentoId, metodo])
  @@index([versaoId])
  @@index([planoPagamentoId])
}

// ─── 19. MATRÍCULA ────────────────────────────────────────────────
// Entidade nova e aditiva (S2.2): representa UM vínculo específico de
// aluno com curso/turma/professor, com suas próprias faturas. Existe em
// paralelo ao vínculo "implícito" que Aluno já carrega (professorId, curso,
// valorMensalidade) — esse continua funcionando exatamente como sempre
// funcionou, sem nenhuma mudança. Matricula é o jeito de um mesmo Aluno ter
// mais de um vínculo simultâneo (ex.: dois cursos, dois professores),
// cada um com seu próprio conjunto de faturas agrupadas.
model Matricula {
  id               String      @id @default(uuid())
  valorMensalidade Float
  diaVencimento    Int         @default(10)
  status           StatusAluno @default(ATIVO)
  dataInicio       DateTime    @default(now())

  // Espelha o campo legado Aluno.tempoContrato, mas por Matricula (auditoria
  // INSTITUTION, 11/09/2026) — um Aluno pode ter mais de uma Matricula ativa
  // (Sprint 5, multi-professor), então "duração do contrato" também precisa
  // ser por matrícula, não mais um dado único do Aluno. Usado por
  // GET /api/renovacoes/vencendo (fimContrato = dataInicio + tempoContrato
  // meses) e POST /api/renovacoes/lote. Nullable: matrícula sem prazo
  // definido simplesmente não entra na fila de renovação.
  tempoContrato Int?

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id])

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  turmaId String?
  turma   Turma?  @relation(fields: [turmaId], references: [id], onDelete: SetNull)

  planoPagamentoId String?
  planoPagamento   PlanoPagamento? @relation(fields: [planoPagamentoId], references: [id], onDelete: SetNull)

  // Plano personalizado (INSTITUTION Sprint 5, briefing 08/09/2026): quando
  // a matrícula não usa um PlanoPagamento global, a escola pode descrever
  // um plano só dela aqui — o valor em si continua sendo valorMensalidade
  // (já existente), este campo é só a descrição livre exibida na ficha.
  planoPersonalizadoDescricao String?

  // Pausa de cobrança pós-avaliação mensal (INSTITUTION Sprint 9, briefing
  // 08/09/2026): quando o aluno responde a avaliação mensal, esse campo
  // recebe o 1º dia do mês seguinte — enquanto "agora < avaliacaoPendenteAte",
  // a régua de cobrança/lembrete não incomoda esse aluno de novo. Checagem
  // direta na tela/rota de cobrança, sem novo model.
  avaliacaoPendenteAte DateTime?

  // Preenchido quando esta matrícula nasce da conversão de um Lead (S4.3) —
  // é o que alimenta o relatório de conversão experimental → matrícula.
  // Não confundir com AulaExperimental.leadId: aqui é o RESULTADO
  // (a matrícula em si), lá é o EVENTO (a aula-teste que pode ou não converter).
  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Cobrança automática (S3.1) — cartão salvo por matrícula, não por Aluno:
  // um Aluno com 2 matrículas pode ter cobrança automática ativa numa e
  // manual na outra, igual às faturas de S2.2 já são separadas por matrícula.
  // stripeCustomerId aponta pra um Customer da conta PLATAFORMA (não da
  // conectada) — a cobrança em si é que é roteada pra Escola via
  // on_behalf_of/transfer_data no PaymentIntent (destination charge).
  cobrancaAutomaticaAtiva Boolean   @default(false)
  stripeCustomerId        String?
  stripePaymentMethodId   String?
  cobrancaUltimoErro      String?
  cobrancaUltimaTentativa DateTime?

  // Cobrança automática via Asaas (Pix/Boleto/Cartão) — segundo gateway,
  // somado ao Stripe acima. gatewayCobranca diz qual dos dois está de fato
  // ativo nesta Matricula (mutuamente exclusivo); cobrancaAutomaticaAtiva/
  // cobrancaUltimoErro/cobrancaUltimaTentativa acima são genéricos e servem
  // pros dois gateways, não duplicados aqui. Diferente do Stripe (cron
  // próprio gerando+cobrando fatura), o Asaas gera a fatura de cada ciclo
  // sozinho via Subscription e avisa por webhook — não precisa de cron.
  gatewayCobranca     GatewayCobranca?
  asaasCustomerId     String?
  asaasSubscriptionId String?

  pagamentos Pagamento[]
  contratos  Contrato[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([alunoId])
  @@index([professorId])
  @@index([escolaId])
  @@index([turmaId])
  @@index([stripeCustomerId])
  @@index([asaasSubscriptionId])
}

// ─── 20. AVALIAÇÃO ────────────────────────────────────────────────
// Aluno avalia o professor — opcionalmente amarrada a uma Aula específica
// (nota + comentário). Sem constraint de "uma avaliação por aula": um
// aluno pode reavaliar, o professor vê a média de todas.
model Avaliacao {
  id         String  @id @default(uuid())
  nota       Int
  comentario String?

  // ─── Avaliação mensal (INSTITUTION Sprint 9, briefing 08/09/2026) ──────
  // notaEscola é separada de `nota` (que continua sendo a nota do
  // professor) — o aluno avalia os dois numa mesma submissão mensal.
  // Nullable de propósito: avaliações de aula pontuais (aulaId preenchido,
  // já existiam antes desta sprint) não têm mesReferencia nem notaEscola.
  notaEscola    Int?
  mesReferencia String? // "YYYY-MM"

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id])

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])

  aulaId String?
  aula   Aula?   @relation(fields: [aulaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([professorId])
  @@index([alunoId])
}

// ─── 21. CRÉDITO DE HORAS / RESERVA DE SALA ──────────────────────
// Moeda interna pra reservar sala fora do horário de aula regular (Emusys).
// Saldo do aluno é sempre computado na hora (soma de CompraCredito menos
// soma de ReservaSala ativa) em vez de guardado num contador — evita
// contador dessincronizado do que realmente aconteceu, ao custo de duas
// agregações a mais por reserva. Escala tranquila pro volume desse app.

// Catálogo de pacotes vendáveis pela Escola (ex.: "Pacote 10h Ensaio").
model PacoteCredito {
  id    String  @id @default(uuid())
  nome  String
  horas Float
  ativo Boolean @default(true)

  escolaId String
  escola   Escola          @relation(fields: [escolaId], references: [id])
  compras  CompraCredito[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escolaId])
}

// Ledger de crédito concedido a um aluno — "compra" no sentido de que o
// professor registrou manualmente (mesmo modelo de confiança que já existe
// pra Pagamento/comprovante: sem gateway processando isso). `horas` é um
// snapshot do pacote no momento da concessão, igual ValorPlano snapshotta
// preço — mudar o pacote depois não altera crédito já concedido.
model CompraCredito {
  id    String @id @default(uuid())
  horas Float

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id])

  pacoteCreditoId String
  pacoteCredito   PacoteCredito @relation(fields: [pacoteCreditoId], references: [id])

  createdAt DateTime @default(now())

  @@index([alunoId])
}

// Reserva de sala usando o crédito. `ativa = false` é como uma reserva é
// cancelada — devolve a hora pro saldo automaticamente, já que o saldo é
// computado excluindo reservas inativas (não precisa de um passo separado
// de "estorno").
model ReservaSala {
  id             String   @id @default(uuid())
  dataHoraInicio DateTime
  horas          Float
  ativa          Boolean  @default(true)

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id])

  salaId String
  sala   Sala   @relation(fields: [salaId], references: [id])

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  createdAt DateTime @default(now())

  @@index([alunoId])
  @@index([salaId, dataHoraInicio])
  @@index([escolaId])
}

// Ciclo de vida do contrato: ENVIADO (professor mandou, aguardando o
// responsável) -> PREENCHIDO (responsável assinou a parte dele, aguardando
// a Escola) -> ASSINADO (representante da Escola assinou também) — ou
// CANCELADO a qualquer momento antes de ASSINADO.
enum StatusContrato {
  ENVIADO
  PREENCHIDO
  ASSINADO
  CANCELADO
}

// ─── 22. CONTRATO DIGITAL ─────────────────────────────────────────
// IMPORTANTE — escopo desta sprint (S3.2): isto é uma confirmação por token
// enviado por e-mail, o mesmo modelo de confiança que já existe em
// TokenRedefinicaoSenha e ConviteProfessor — NÃO é assinatura eletrônica
// com validade jurídica plena (ICP-Brasil, carimbo de tempo, etc.), que é
// o que um parceiro como Clicksign/D4Sign entrega de verdade. Integrar um
// parceiro desses fica como decisão de negócio em aberto (ver roadmap).
// Isso aqui já resolve o problema prático imediato: cobrança só sai depois
// que as duas partes confirmaram.
model Contrato {
  id     String         @id @default(uuid())
  status StatusContrato @default(ENVIADO)

  // Token que o responsável usa pra acessar e assinar — é o "segredo" que
  // prova que quem está confirmando recebeu o e-mail (mesmo padrão do
  // código de convite). Não reaproveitável depois de PREENCHIDO.
  token String @unique

  testemunhas String[] // nomes livres, configurável por contrato

  nomeAssinanteResponsavel  String?
  cpfAssinanteResponsavel   String?
  assinadoPeloResponsavelEm DateTime?

  nomeRepresentanteEscola     String?
  assinadoPeloRepresentanteEm DateTime?

  matriculaId String
  matricula   Matricula @relation(fields: [matriculaId], references: [id])

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matriculaId])
  @@index([escolaId])
}

// ─── 23. BACKOFFICE FINANCEIRO MÍNIMO ─────────────────────────────
// Versão enxuta do módulo clássico de caixa da Emusys — só o necessário
// pra escola não precisar de planilha paralela, sem tesouraria/conciliação
// bancária/repasse de cartão (isso é ERP financeiro de verdade, fora de
// escopo aqui).

enum TipoLancamentoCaixa {
  ENTRADA
  SAIDA
}

// Movimento de caixa que já aconteceu de verdade (dinheiro entrou/saiu).
// Pode ser avulso (professor lança na mão) ou gerado automaticamente ao
// pagar uma ContaPagar (ver PUT /api/contas-pagar/:id/pagar).
model LancamentoCaixa {
  id        String              @id @default(uuid())
  tipo      TipoLancamentoCaixa
  descricao String
  valor     Float
  data      DateTime            @default(now())

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  contaPagarId String?
  contaPagar   ContaPagar? @relation(fields: [contaPagarId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([escolaId, data])
}

// Fecha um dia: soma congelada no momento do fechamento — não recalcula
// depois, mesmo que lançamentos daquele dia mudem (fechamento é uma foto,
// não uma view). Um fechamento só por dia por Escola.
model FechamentoCaixa {
  id            String   @id @default(uuid())
  data          DateTime
  saldoInicial  Float
  totalEntradas Float
  totalSaidas   Float
  saldoFinal    Float

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  createdAt DateTime @default(now())

  @@unique([escolaId, data])
  @@index([escolaId])
}

// Despesa da escola — nasce sem afetar o caixa; só quando marcada como paga
// (PUT /api/contas-pagar/:id/pagar) é que vira um LancamentoCaixa de saída.
model ContaPagar {
  id         String    @id @default(uuid())
  descricao  String
  valor      Float
  vencimento DateTime
  paga       Boolean   @default(false)
  pagoEm     DateTime?

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  lancamentos LancamentoCaixa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escolaId, paga])
}

// ─── FOLHA DE PAGAMENTO DE PROFESSOR (INSTITUTION Sprint 7, briefing 08/09/2026) ───
// "O coração do sistema", nas palavras do usuário. v1 pragmática de
// S8.3/RegraPagamentoProfessor do roadmap mestre: cálculo global por Escola
// (Escola.valorPorAula + tipoRemuneracaoProfessor, Sprint 1), sem regra por
// professor individual — isso fica pra quando a Fase 7/RBAC existir e
// justificar a complexidade extra (ver docs/institution-briefing-2026-09-08.md §6).
enum StatusFolhaPagamento {
  ABERTA
  FECHADA
}

model FolhaPagamentoProfessor {
  id             String               @id @default(uuid())
  mes            Int
  ano            Int
  valorCalculado Float
  // Nullable de propósito: só preenchido quando a escola ajusta manualmente
  // — enquanto null, o valor exibido é sempre valorCalculado.
  valorAjustado  Float?
  comprovantes   String[] // até 3 URLs, validado em app
  status         StatusFolhaPagamento @default(ABERTA)

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])
  escolaId    String
  escola      Escola    @relation(fields: [escolaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([professorId, mes, ano])
  @@index([escolaId, mes, ano])
}

// ─── DESPESA FIXA (INSTITUTION Sprint 7, briefing 08/09/2026) ────────────
// Despesa recorrente da Escola (aluguel, internet, etc.), editável pela
// própria instituição. Despesas avulsas (não-recorrentes) reusam ContaPagar,
// que já existia — sem model novo pra isso.
model DespesaFixa {
  id         String  @id @default(uuid())
  descricao  String
  valor      Float
  recorrente Boolean @default(true)
  ativa      Boolean @default(true)

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escolaId, ativa])
}

// ─── 24. CRM DE LEADS ──────────────────────────────────────────────
// Funil configurável por Escola — cada Escola define seus próprios
// estágios (ex.: "Em Diálogo", "Aula experimental marcada"), não um enum
// fixo. "Sem refresh manual" no critério de pronto do roadmap é atendido
// pelo mesmo padrão que o resto do app já usa (refetch ao focar a tela);
// notificação por websocket/push em tempo real fica fora de escopo desta
// sprint, registrado no runbook, não é suposição silenciosa.

model EstagioFunil {
  id    String  @id @default(uuid())
  nome  String
  ordem Int
  ativo Boolean @default(true)

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])
  leads    Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escolaId])
}

model Lead {
  id       String  @id @default(uuid())
  nome     String
  telefone String?
  email    String?
  origem   String? // texto livre: "Instagram", "Indicação", etc.

  arquivado          Boolean @default(false)
  motivoArquivamento String?

  // Link público de auto-cadastro pra ESTE lead específico (S4.2) — gerado
  // sob demanda por POST /api/leads/:id/link-cadastro. Diferente de
  // LinkCaptacao (que é reutilizável e cria leads NOVOS), este token deixa o
  // próprio lead completar telefone/email sem precisar de conta no app.
  tokenPublico String? @unique

  estagioId String
  estagio   EstagioFunil @relation(fields: [estagioId], references: [id])

  // Professor de interesse (opcional) — em quem o lead tem interesse, se já
  // souber. Não confundir com "quem está cuidando do follow-up", que é por
  // TarefaLead.
  professorId String?
  professor   Professor? @relation(fields: [professorId], references: [id], onDelete: SetNull)

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  tarefas            TarefaLead[]
  aulasExperimentais AulaExperimental[]
  // Lado "um" da relação 1:1 — a FK única de verdade mora em Matricula.leadId.
  matricula          Matricula?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escolaId, arquivado])
  @@index([estagioId])
}

// Tarefa de follow-up — "aparece na tela inicial" do gestor/professor
// responsável enquanto não concluída.
model TarefaLead {
  id           String    @id @default(uuid())
  descricao    String
  dataPrevista DateTime
  concluida    Boolean   @default(false)
  concluidaEm  DateTime?

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id])

  responsavelId String?
  responsavel   Professor? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  createdAt DateTime @default(now())

  @@index([escolaId, concluida])
  @@index([leadId])
}

// ─── LINK DE CAPTAÇÃO (Fase 4, S4.2) ────────────────────────────
//
// Link público reutilizável (não expira sozinho, só via "ativo") pra captar
// lead SEM conta e SEM app instalado: formulário embutível em site/redes, ou
// agendamento de aula experimental. Token é o único jeito de achar o
// registro — sem rota de listagem pública nem enumeração por id sequencial.
enum TipoLinkCaptacao {
  CADASTRO
  AGENDAMENTO_EXPERIMENTAL
}

model LinkCaptacao {
  id    String           @id @default(uuid())
  token String           @unique
  tipo  TipoLinkCaptacao
  ativo Boolean          @default(true)

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  // Se preenchido, todo lead capturado por este link já nasce atribuído a
  // este professor (link pessoal, ex.: no Instagram do próprio professor).
  // Se nulo, é um link da Escola em geral.
  professorId String?
  professor   Professor? @relation(fields: [professorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([escolaId])
}

// ─── AULA EXPERIMENTAL (Fase 4, S4.3) ────────────────────────────
//
// Aula-teste vinculada a um Lead (não a um Aluno — ele ainda não é aluno).
// A conversão em si não é um campo aqui: é derivada em tempo de consulta,
// olhando se o Lead ganhou uma Matricula (Matricula.leadId) depois da
// dataHora desta aula-teste, respeitando a regra configurável da Escola
// (Escola.regraConversaoExperimental). Ver GET /api/relatorios/conversao-experimental.
enum StatusAulaExperimental {
  AGENDADA
  REALIZADA
  NAO_COMPARECEU
  CANCELADA
}

enum RegraConversaoExperimental {
  QUALQUER_MATRICULA
  MESMO_CURSO_PROFESSOR
}

model AulaExperimental {
  id         String                 @id @default(uuid())
  dataHora   DateTime
  status     StatusAulaExperimental @default(AGENDADA)
  observacao String?

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id])

  cursoId String?
  curso   Curso?  @relation(fields: [cursoId], references: [id], onDelete: SetNull)

  professorId String?
  professor   Professor? @relation(fields: [professorId], references: [id], onDelete: SetNull)

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escolaId, dataHora])
  @@index([leadId])
}

// ─── CALENDÁRIO DA ESCOLA (Fase 1, S1.4) ─────────────────────────
//
// Feriados/recessos por Escola. "Agenda respeita automaticamente" (S1.4)
// é aplicado no ponto de criação de aula avulsa (POST /api/aulas) — não
// existe neste código um motor de geração recorrente de aula a partir de
// Turma/Matricula pra "respeitar" em outro lugar (cada Aula nasce como um
// registro concreto, não derivado de uma regra semanal). Ver runbook de
// S1.4 pra essa decisão de escopo, registrada, não assumida em silêncio.
// Tipos novos (INSTITUTION Sprint 10, briefing 08/09/2026): PALESTRA,
// PASSEIO, FESTIVAL, APRESENTACAO e FERIAS — o antigo "Calendário" só
// cobria feriado/recesso da escola inteira; "Cronograma" cobre qualquer
// evento (bloqueia agenda dos cursos afetados, não conta falta).
enum TipoDiaNaoLetivo {
  FERIADO
  RECESSO
  PALESTRA
  PASSEIO
  FESTIVAL
  APRESENTACAO
  FERIAS
}

model DiaNaoLetivo {
  id        String           @id @default(uuid())
  data      DateTime
  descricao String
  tipo      TipoDiaNaoLetivo @default(FERIADO)

  // Nullable de propósito (Sprint 10): evento de 1 dia só (o caso de sempre,
  // feriado/recesso pontual) não precisa preencher — `data` sozinha já
  // define o dia. Preenchido só quando o evento cobre um intervalo
  // (ex.: "Férias de julho").
  dataFim DateTime?

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  // Cursos afetados (N:N). Vazio = escola inteira, compatível com todo
  // registro criado antes desta sprint (que sempre foi escola inteira).
  cursos DiaNaoLetivoCurso[]

  createdAt DateTime @default(now())

  @@unique([escolaId, data])
  @@index([escolaId])
}

model DiaNaoLetivoCurso {
  diaNaoLetivoId String
  diaNaoLetivo   DiaNaoLetivo @relation(fields: [diaNaoLetivoId], references: [id], onDelete: Cascade)
  cursoId        String
  curso          Curso        @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@id([diaNaoLetivoId, cursoId])
  @@index([cursoId])
}

// ─── COMUNICADOS EM ESCALA (Fase 5, S5.1) ────────────────────────
//
// Broadcast escopado pela Escola inteira (não por professor isolado —
// nada parecido existia antes desta sprint). RASCUNHO edita/apaga livre;
// ENVIADO é definitivo — sem rota de "desenviar" ou reabrir edição, de
// propósito (é o critério de pronto do roadmap).
enum StatusComunicado {
  RASCUNHO
  ENVIADO
}

// Quem recebe — um cálculo automático a partir do público escolhido, não
// uma seleção manual de destinatário por destinatário (mantém o recurso
// simples: "manda pra Escola toda", não um mailing list picker).
enum PublicoComunicado {
  ALUNOS
  PROFESSORES
  TODOS
}

model Comunicado {
  id      String            @id @default(uuid())
  titulo  String
  corpo   String
  publico PublicoComunicado
  status  StatusComunicado  @default(RASCUNHO)

  enviadoEm DateTime?

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  autorId String
  autor   Professor @relation(fields: [autorId], references: [id])

  envios EnvioComunicado[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escolaId, status])
}

// Histórico completo por destinatário (não só um contador agregado) — é
// literalmente a entrega "histórico completo de e-mails enviados" do
// roadmap: dá pra auditar quem recebeu, quem não recebeu e por quê.
model EnvioComunicado {
  id                String  @id @default(uuid())
  destinatarioNome  String
  destinatarioEmail String
  destinatarioTipo  String // "ALUNO" | "PROFESSOR"
  sucesso           Boolean
  erro              String?

  // Push + leitura no app do aluno (INSTITUTION Sprint 11, briefing
  // 08/09/2026). Reaproveita esta mesma tabela (que já rastreava entrega de
  // e-mail por destinatário) em vez de criar uma tabela nova só pra push —
  // alunoId é nullable de propósito: só preenchido quando destinatarioTipo
  // = "ALUNO" (Professor não tem tela de "comunicados lidos" no app).
  alunoId String?
  aluno   Aluno?    @relation(fields: [alunoId], references: [id], onDelete: SetNull)
  lidoEm  DateTime?

  comunicadoId String
  comunicado   Comunicado @relation(fields: [comunicadoId], references: [id])

  createdAt DateTime @default(now())

  @@index([comunicadoId])
  @@index([alunoId, lidoEm])
}

// ─── ESTOQUE SIMPLES (Fase 5, S5.5) ────────────────────────
//
// "Simples" de propósito, registrado no roadmap: sem categoria, sem
// fornecedor, sem custo/preço de venda — só quantidade em estoque e o
// histórico de movimentações (entrada/saída/empréstimo/devolução) que
// leva a esse número. quantidadeEstoque é o saldo atual, mantido em
// sincronia a cada movimentação criada (não é recalculado on-the-fly a
// cada consulta, pra não escanear o histórico inteiro toda vez).
enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
  EMPRESTIMO
  DEVOLUCAO
}

model Produto {
  id                String  @id @default(uuid())
  nome              String
  descricao         String?
  quantidadeEstoque Int     @default(0)
  ativo             Boolean @default(true)

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  movimentacoes MovimentacaoEstoque[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escolaId])
}

model MovimentacaoEstoque {
  id         String                  @id @default(uuid())
  tipo       TipoMovimentacaoEstoque
  quantidade Int
  observacao String?

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  // Só preenchido em EMPRESTIMO/DEVOLUCAO — quem pegou/devolveu. "Simples"
  // quer dizer: não existe um registro de "empréstimo aberto" formal, é
  // derivado (soma de EMPRESTIMO menos soma de DEVOLUCAO por aluno+produto)
  // — ver GET /api/estoque/emprestimos-ativos.
  alunoId String?
  aluno   Aluno?  @relation(fields: [alunoId], references: [id], onDelete: SetNull)

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  createdAt DateTime @default(now())

  @@index([produtoId])
  @@index([escolaId])
  @@index([alunoId])
}
