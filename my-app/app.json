{
  "expo": {
    "name": "KAV Class",
    "slug": "kav-class",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kavclass",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "buildNumber": "2",
      "supportsTablet": true,
      "bundleIdentifier": "com.teclas.jr566.kavclass",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.teclas.jr566.kavclass"
    },
    "notification": {
      "icon": "./assets/images/android-icon-monochrome.png",
      "color": "#32BCAD",
      "androidMode": "default",
      "androidCollapsedTitle": "KAV Class",
      "iosDisplayInForeground": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withAdiRegistration",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita o uso do Face ID para acessar sua conta KAV Class com segurança e rapidez."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#32BCAD",
          "defaultChannel": "kav-class"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f4a68d8-0fa8-4912-82fc-56ba4624e94c"
      },
      "googleClientIds": {
        "web": "",
        "ios": "",
        "android": ""
      }
    },
    "owner": "teclas.jr566",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7f4a68d8-0fa8-4912-82fc-56ba4624e94c"
    }
  }
}